#!/usr/bin/env python3

# Generates procedural textures of Dust Racing 2D into data/images.
# The output is deterministic, so the textures can be regenerated and tweaked at any time.
# Requires Pillow and NumPy. Must be run in the project root.
#
# Usage: scripts/generate-textures [NAME...]
# Without names all textures are generated.

import math
import sys

import numpy as np
from PIL import Image, ImageDraw, ImageFilter

IMAGE_PATH = 'data/images/'

# Scene light comes from the upper left (in image coordinates y grows downwards).
LIGHT = np.array([-1.0, -1.0, 1.2]) / np.linalg.norm([-1.0, -1.0, 1.2])

# Sprites are drawn supersampled and then scaled down for anti-aliasing.
SUPERSAMPLING = 2


def shade(normal):
    """Lambertian shading with some ambient light."""
    return 0.5 + 0.65 * max(0.0, float(np.dot(normal, LIGHT)))


def finish_sprite(image, size):
    """Scales a supersampled sprite down and keeps colors of the semi-transparent edges intact."""
    image = image.resize((size, size), Image.LANCZOS)
    pixels = np.asarray(image).astype(np.float32)
    # The game discards nearly transparent pixels and draws the rest without blending,
    # so make the silhouette crisp.
    alpha = pixels[..., 3]
    pixels[..., 3] = np.where(alpha > 96, 255, 0)
    return Image.fromarray(pixels.clip(0, 255).astype(np.uint8), 'RGBA')


def leaf_polygon(x, y, length, width, angle):
    """A pointed leaf as a polygon."""
    points = []
    for t in np.linspace(0, 2 * math.pi, 14, endpoint=False):
        # Lemon-shaped outline: pointed at both ends
        u = math.cos(t) * length / 2
        v = math.sin(t) * width / 2 * abs(math.sin(t)) ** 0.3
        points.append((x + u * math.cos(angle) - v * math.sin(angle), y + u * math.sin(angle) + v * math.cos(angle)))
    return points


def draw_foliage(draw, rng, cx, cy, radius, leaves, leaf_length, base_hue, domes=7):
    """Draws a clump of leafy domes centered at (cx, cy). Leaves are lit by their position on the domes.
    leaf_length is the (min, max) length of the leaves in pixels."""
    clump = [(cx, cy, radius * 0.55)]
    for _ in range(domes):
        angle = rng.uniform(0, 2 * math.pi)
        distance = rng.uniform(0.25, 0.55) * radius
        clump.append((cx + math.cos(angle) * distance, cy + math.sin(angle) * distance, rng.uniform(0.3, 0.45) * radius))

    items = []
    for _ in range(leaves):
        dx, dy, dr = clump[rng.integers(len(clump))]
        # Denser towards the center of a dome
        r = dr * math.sqrt(rng.uniform(0, 1)) ** 0.8
        a = rng.uniform(0, 2 * math.pi)
        x, y = dx + math.cos(a) * r, dy + math.sin(a) * r
        if math.hypot(x - cx, y - cy) > radius:
            continue
        # Height and normal on the dome
        nx, ny = (x - dx) / dr, (y - dy) / dr
        nz = math.sqrt(max(0.05, 1 - nx * nx - ny * ny))
        normal = np.array([nx, ny, nz]) / math.sqrt(nx * nx + ny * ny + nz * nz)
        # Leaves face roughly up but are tilted randomly
        normal = normal + rng.normal(0, 0.35, 3)
        normal /= np.linalg.norm(normal)
        items.append((nz, x, y, a, normal))

    # Draw from the bottom to the top of the domes
    for height, x, y, a, normal in sorted(items, key=lambda item: item[0]):
        light = shade(normal) * (0.6 + 0.4 * height)
        variation = rng.normal(0, 0.07, 3)
        color = [int(np.clip(c * (light + v), 0, 255)) for c, v in zip(base_hue, variation)]
        length = rng.uniform(*leaf_length)
        angle = a + rng.normal(0, 0.6)
        draw.polygon(leaf_polygon(x, y, length, length * 0.55, angle), fill=(*color, 255))


def deciduous_canopy(seed, size=128, leaves=1100, base_hue=(70, 125, 45)):
    """A slice of a deciduous tree crown: a clump of leafy domes with gaps between the leaves."""
    rng = np.random.default_rng(seed)
    s = size * SUPERSAMPLING
    image = Image.new('RGBA', (s, s), (0, 0, 0, 0))
    leaf_scale = SUPERSAMPLING / 2 * size / 64
    draw_foliage(ImageDraw.Draw(image), rng, s / 2, s / 2, s * 0.47, leaves, (9 * leaf_scale, 15 * leaf_scale), base_hue)
    return finish_sprite(image, size)


def shrub(seed, size=64, base_hue=(75, 120, 45), flowers=(235, 215, 90)):
    """A small leafy shrub with a few flowers."""
    rng = np.random.default_rng(seed)
    s = size * SUPERSAMPLING
    image = Image.new('RGBA', (s, s), (0, 0, 0, 0))
    draw = ImageDraw.Draw(image)
    draw_foliage(draw, rng, s / 2, s / 2, s * 0.46, 420, (3 * SUPERSAMPLING, 5 * SUPERSAMPLING), base_hue, domes=5)
    for _ in range(14):
        r = s * 0.36 * math.sqrt(rng.uniform(0, 1))
        a = rng.uniform(0, 2 * math.pi)
        x, y = s / 2 + math.cos(a) * r, s / 2 + math.sin(a) * r
        petal = SUPERSAMPLING * rng.uniform(0.9, 1.4)
        draw.ellipse((x - petal, y - petal, x + petal, y + petal), fill=(*flowers, 255))
    return finish_sprite(image, size)


def grass_tuft(draw, rng, cx, cy, radius, base_hue):
    """Blades of tall grass radiating from (cx, cy)."""
    blades = []
    for _ in range(int(radius * 3)):
        angle = rng.uniform(0, 2 * math.pi)
        length = radius * rng.uniform(0.4, 1.0)
        bend = rng.normal(0, 0.3)
        # Blades that point towards the light are lit
        normal = np.array([math.cos(angle), math.sin(angle), 1.0]) / math.sqrt(2)
        blades.append((length, angle, bend, normal))
    for length, angle, bend, normal in sorted(blades, key=lambda blade: -blade[0]):
        light = shade(normal) * rng.uniform(0.8, 1.1)
        color = tuple(int(np.clip(c * light, 0, 255)) for c in base_hue)
        points = [(cx + math.cos(angle + bend * t * t) * length * t, cy + math.sin(angle + bend * t * t) * length * t) for t in np.linspace(0, 1, 5)]
        draw.line(points, fill=(*color, 255), width=SUPERSAMPLING)


def bush_area(seed, size=128):
    """A patch of low shrubs and tall grass with gaps between them."""
    rng = np.random.default_rng(seed)
    s = size * SUPERSAMPLING
    image = Image.new('RGBA', (s, s), (0, 0, 0, 0))
    draw = ImageDraw.Draw(image)
    for _ in range(60):
        r = s * 0.42 * math.sqrt(rng.uniform(0, 1))
        a = rng.uniform(0, 2 * math.pi)
        x, y = s / 2 + math.cos(a) * r, s / 2 + math.sin(a) * r
        if rng.uniform() < 0.35:
            hue = (int(rng.uniform(60, 80)), int(rng.uniform(105, 125)), 40)
            draw_foliage(draw, rng, x, y, s * rng.uniform(0.05, 0.09), 90, (2 * SUPERSAMPLING, 4 * SUPERSAMPLING), hue, domes=3)
        else:
            hue = (int(rng.uniform(95, 130)), int(rng.uniform(125, 145)), 50)
            grass_tuft(draw, rng, x, y, s * rng.uniform(0.04, 0.07), hue)
    return finish_sprite(image, size)


def pine_canopy(seed, size=128, branches=11, base_hue=(45, 95, 60)):
    """A slice of a pine crown: needle sprays radiating from the trunk."""
    rng = np.random.default_rng(seed)
    s = size * SUPERSAMPLING
    center = s / 2
    radius = s * 0.47

    image = Image.new('RGBA', (s, s), (0, 0, 0, 0))
    draw = ImageDraw.Draw(image)

    strokes = []
    for i in range(branches):
        angle = (i + rng.uniform(-0.3, 0.3)) * 2 * math.pi / branches
        length = radius * rng.uniform(0.75, 1.0)
        for t in np.linspace(0.08, 1.0, 26):
            # Branch droops and slightly curves
            curve = angle + 0.15 * math.sin(t * 3 + i)
            bx, by = center + math.cos(curve) * length * t, center + math.sin(curve) * length * t
            twig = length * 0.28 * (1.1 - t)
            for side in (-1, 1):
                for _ in range(3):
                    needle_angle = curve + side * rng.uniform(0.5, 1.1)
                    needle_length = twig * rng.uniform(0.5, 1.0) + 3 * SUPERSAMPLING
                    ex, ey = bx + math.cos(needle_angle) * needle_length, by + math.sin(needle_angle) * needle_length
                    # Needle sprays slope down from the branch
                    normal = np.array([math.cos(needle_angle), math.sin(needle_angle), 1.3 - t * 0.5])
                    normal /= np.linalg.norm(normal)
                    strokes.append((1 - t, (bx, by, ex, ey), normal))

    for height, (bx, by, ex, ey), normal in sorted(strokes, key=lambda item: item[0]):
        light = shade(normal) * (0.65 + 0.35 * height)
        variation = rng.normal(0, 0.06, 3)
        color = tuple(int(np.clip(c * (light + v), 0, 255)) for c, v in zip(base_hue, variation))
        draw.line((bx, by, ex, ey), fill=(*color, 255), width=max(1, SUPERSAMPLING * size // 96))
    return finish_sprite(image, size)


def trunk(seed, size=32, base_hue=(95, 70, 45)):
    """A cross-section of a tree trunk seen from above: a rounded, shaded column of bark."""
    rng = np.random.default_rng(seed)
    s = size * SUPERSAMPLING
    y, x = (np.mgrid[0:s, 0:s] + 0.5) / s * 2 - 1
    r = np.hypot(x, y)
    inside = r < 0.92
    # Cylinder-like normals: the column bulges towards the viewer
    nz = np.sqrt(np.clip(1 - r * r, 0.05, 1))
    normals = np.stack([x, y, nz], axis=-1) / np.sqrt(x * x + y * y + nz * nz)[..., None]
    light = 0.45 + 0.75 * np.clip(normals @ LIGHT, 0, 1)
    # Bark ridges run around the trunk
    angle = np.arctan2(y, x)
    ridges = 0.85 + 0.15 * np.sin(angle * 23 + rng.uniform(0, 6) + 3 * np.sin(angle * 5)) * r
    grain = 1 + rng.normal(0, 0.06, (s, s))
    shading = light * ridges * grain
    pixels = np.zeros((s, s, 4))
    pixels[..., :3] = np.array(base_hue)[None, None, :] * shading[..., None]
    pixels[..., 3] = np.where(inside, 255, 0)
    image = Image.fromarray(pixels.clip(0, 255).astype(np.uint8), 'RGBA')
    return finish_sprite(image, size)


def periodic_noise(rng, size, sigma):
    """Smooth, tileable noise with unit variance. sigma is the feature size in pixels."""
    frequencies = np.fft.fftfreq(size)
    fx, fy = np.meshgrid(frequencies, frequencies)
    spectrum = np.fft.fft2(rng.normal(size=(size, size))) * np.exp(-2 * (math.pi * sigma) ** 2 * (fx * fx + fy * fy))
    noise = np.real(np.fft.ifft2(spectrum))
    return (noise - noise.mean()) / noise.std()


def sand_rgb(seed, size=256, base_color=(200, 172, 128)):
    """Tileable sand with grain, wind ripples and some pebbles. Returns float RGB in 0..255."""
    rng = np.random.default_rng(seed)
    y, x = np.mgrid[0:size, 0:size]

    # Wind ripples. Integer wave numbers keep them tileable.
    warp = periodic_noise(rng, size, 18)
    phase = 2 * math.pi * (5 * x + 14 * y) / size + 1.2 * warp
    ripples = np.sin(phase) + 0.35 * np.sin(2 * phase)
    height = 0.45 * periodic_noise(rng, size, 30) + 0.25 * ripples * (0.6 + 0.4 * periodic_noise(rng, size, 40))
    grain = periodic_noise(rng, size, 0.6)

    brightness = 1 + 0.07 * height + 0.05 * grain
    rgb = np.array(base_color)[None, None, :] * brightness[..., None]
    # Grains of different minerals
    tint = periodic_noise(rng, size, 0.5)
    rgb[..., 0] *= 1 + 0.03 * tint
    rgb[..., 2] *= 1 - 0.05 * tint

    # Pebbles lit from the scene light, drawn with wrap-around
    image = Image.fromarray(rgb.clip(0, 255).astype(np.uint8), 'RGB')
    draw = ImageDraw.Draw(image)
    for _ in range(45):
        px, py = rng.uniform(0, size, 2)
        r = rng.uniform(0.8, 2.0)
        color = np.array(base_color) * rng.uniform(0.55, 0.8) * np.array([1.0, 0.97, 0.95])
        for ox in (-size, 0, size):
            for oy in (-size, 0, size):
                cx, cy = px + ox, py + oy
                draw.ellipse((cx - r, cy - r, cx + r, cy + r), fill=tuple(color.astype(int)))
                highlight = r * 0.45
                draw.ellipse((cx - r * 0.5 - highlight, cy - r * 0.5 - highlight, cx - r * 0.5 + highlight, cy - r * 0.5 + highlight), fill=tuple((color * 1.35).clip(0, 255).astype(int)))
    return np.asarray(image).astype(np.float32)


def sand(seed, size=256):
    return Image.fromarray(sand_rgb(seed, size).clip(0, 255).astype(np.uint8), 'RGB')


def sand_area(source, seed):
    """Fills the shape of a sand area object with sand. The alpha channel of the source stays."""
    image = np.asarray(Image.open(IMAGE_PATH + source).convert('RGBA')).astype(np.float32)
    h, w = image.shape[:2]
    texture = sand_rgb(seed)
    tiles = np.tile(texture, (h // texture.shape[0] + 1, w // texture.shape[1] + 1, 1))
    image[..., :3] = tiles[:h, :w]
    return Image.fromarray(image.clip(0, 255).astype(np.uint8), 'RGBA')


KERB_RED = np.array([205, 35, 35])
KERB_WHITE = np.array([238, 236, 228])


def kerbed_mask(source, inside_region, stripe_length=16):
    """Paints red and white kerbs over the edge line and its dark band at the inside of a corner.
    source is a track tile mask, inside_region(x, y) selects the inside edge of the corner and
    stripe_length is in pixels of the mask."""
    image = Image.open(IMAGE_PATH + source).convert('RGBA')
    pixels = np.asarray(image).astype(np.float32)
    h, w = pixels.shape[:2]
    y, x = np.mgrid[0:h, 0:w] + 0.5
    rgb = pixels[..., :3]

    # Painted line pixels, possibly anti-aliased with the green material key
    green = np.clip((rgb[..., 1] - np.maximum(rgb[..., 0], rgb[..., 2])) / 255, 0, 1)
    painted = (rgb.max(axis=-1) > 15) & (green < 0.95) & (pixels[..., 3] > 0) & inside_region(x, y)

    # Trace the white line as a polyline. The line bends around a single point, so it can be
    # ordered by the angle around the center of a circle fitted to it.
    white = painted & (rgb.min(axis=-1) > 200)
    a = np.stack([x[white], y[white], np.ones(white.sum())], axis=-1)
    b = x[white] ** 2 + y[white] ** 2
    cx2, cy2, _ = np.linalg.lstsq(a, b, rcond=None)[0]
    cx, cy = cx2 / 2, cy2 / 2
    # Measure angles relative to the mean direction so that they don't wrap around
    directions = (x[white] - cx) + 1j * (y[white] - cy)
    mean_direction = directions.mean() / abs(directions.mean())
    angles = np.angle(directions * np.conj(mean_direction))
    bins = np.linspace(angles.min(), angles.max(), 120)
    index = np.digitize(angles, bins)
    polyline = np.array([(x[white][index == i].mean(), y[white][index == i].mean()) for i in np.unique(index)])
    arc_length = np.concatenate([[0], np.cumsum(np.hypot(*np.diff(polyline, axis=0).T))])

    # Stripes follow the distance along the line. Supersample them for anti-aliasing.
    py, px = np.nonzero(painted)
    offsets = (np.arange(4) + 0.5) / 4
    red = np.zeros(len(px))
    for oy in offsets:
        for ox in offsets:
            points = np.stack([px + ox, py + oy], axis=-1)
            nearest = np.argmin(((points[:, None, :] - polyline[None, :, :]) ** 2).sum(axis=-1), axis=1)
            red += (np.floor(arc_length[nearest] / stripe_length) % 2 == 0)
    red = (red / 16)[:, None]
    kerb = red * KERB_RED + (1 - red) * KERB_WHITE

    f = green[py, px][:, None]
    pixels[py, px, :3] = kerb * (1 - f) + np.array([0, 255, 0]) * f
    return Image.fromarray(pixels.clip(0, 255).astype(np.uint8), 'RGBA')


def grass_rgb(seed, width, height, base_color=(92, 128, 60)):
    """Grass with large patches of different shades and fine grain. Returns float RGB in 0..255."""
    rng = np.random.default_rng(seed)
    size = max(width, height)
    patches = periodic_noise(rng, size, 60)[:height, :width]
    detail = periodic_noise(rng, size, 6)[:height, :width]
    grain = periodic_noise(rng, size, 0.7)[:height, :width]
    brightness = 1 + 0.09 * patches + 0.05 * detail + 0.06 * grain
    rgb = np.array(base_color)[None, None, :] * brightness[..., None]
    # Dry, yellowish patches
    dryness = np.clip(periodic_noise(rng, size, 45)[:height, :width], 0, None)[..., None]
    return rgb * (1 - 0.15 * dryness) + np.array([150, 140, 80]) * 0.15 * dryness


def smooth_path(points, samples_per_segment=40):
    """A Catmull-Rom spline through the given points. Returns the samples and their unit normals."""
    points = np.array(points, dtype=np.float64)
    padded = np.vstack([2 * points[0] - points[1], points, 2 * points[-1] - points[-2]])
    samples = []
    for i in range(1, len(padded) - 2):
        p0, p1, p2, p3 = padded[i - 1:i + 3]
        for t in np.linspace(0, 1, samples_per_segment, endpoint=False):
            samples.append(0.5 * ((2 * p1) + (-p0 + p2) * t + (2 * p0 - 5 * p1 + 4 * p2 - p3) * t * t + (-p0 + 3 * p1 - 3 * p2 + p3) * t * t * t))
    samples.append(points[-1])
    samples = np.array(samples)
    tangents = np.gradient(samples, axis=0)
    tangents /= np.linalg.norm(tangents, axis=1)[:, None]
    normals = np.stack([-tangents[:, 1], tangents[:, 0]], axis=-1)
    return samples, normals


def road_mask(size, samples, width):
    """Mask of a road of the given width along the samples. It's stamped with discs, because
    wide polylines of short segments leave gaps between the segments."""
    mask = Image.new('L', size, 0)
    draw = ImageDraw.Draw(mask)
    r = width / 2
    step = max(1.0, r / 8)
    distance = 0.0
    previous = samples[0]
    for p in samples:
        distance += np.linalg.norm(p - previous)
        previous = p
        if distance >= step or p is samples[0] or p is samples[-1]:
            distance = 0.0
            draw.ellipse((p[0] - r, p[1] - r, p[0] + r, p[1] + r), fill=255)
    return mask


def dense_path(samples, normals, spacing):
    """Resamples a path so that its samples are at most the given spacing apart."""
    step = np.linalg.norm(np.diff(samples, axis=0), axis=1)
    arc_length = np.concatenate([[0], np.cumsum(step)])
    positions = np.arange(0, arc_length[-1], spacing)
    resampled = np.stack([np.interp(positions, arc_length, samples[:, i]) for i in range(2)], axis=-1)
    resampled_normals = np.stack([np.interp(positions, arc_length, normals[:, i]) for i in range(2)], axis=-1)
    resampled_normals /= np.linalg.norm(resampled_normals, axis=1)[:, None]
    return resampled, resampled_normals


def draw_kerbs(draw, samples, normals, road_width, kerb_width, stripe_length, min_length):
    """Red and white kerbs at the inside of the bends, where the road curves enough.
    Kerbs shorter than min_length are left out."""
    tangents = np.gradient(samples, axis=0)
    heading = np.unwrap(np.arctan2(tangents[:, 1], tangents[:, 0]))
    step = np.linalg.norm(np.diff(samples, axis=0), axis=1)
    curvature = np.gradient(heading) / np.maximum(np.concatenate([step, step[-1:]]), 1e-6)
    curvature = np.convolve(curvature, np.ones(41) / 41, mode='same')
    arc_length = np.concatenate([[0], np.cumsum(step)])

    # Find runs of bends and drop the short ones
    curved = np.abs(curvature) >= 0.0008
    for start in np.flatnonzero(curved & ~np.concatenate([[False], curved[:-1]])):
        end = start
        while end + 1 < len(curved) and curved[end + 1] and np.sign(curvature[end + 1]) == np.sign(curvature[start]):
            end += 1
        if arc_length[end] - arc_length[start] < min_length:
            curved[start:end + 1] = False

    for i in range(len(samples) - 1):
        if not curved[i]:
            continue
        # The inside of the bend is on the side the road turns to
        side = 1 if curvature[i] > 0 else -1
        outer, inner = side * road_width / 2, side * (road_width / 2 - kerb_width)
        quad = [tuple(samples[i] + normals[i] * outer), tuple(samples[i + 1] + normals[i + 1] * outer),
                tuple(samples[i + 1] + normals[i + 1] * inner), tuple(samples[i] + normals[i] * inner)]
        red = int(arc_length[i] / stripe_length) % 2 == 0
        draw.polygon(quad, fill=tuple(KERB_RED) if red else tuple(KERB_WHITE))


def tree_sprite(rng, size):
    """A random deciduous or pine crown sprite."""
    seed = int(rng.integers(1000))
    if rng.uniform() < 0.35:
        return pine_canopy(seed, size=size, base_hue=(int(rng.uniform(38, 50)), int(rng.uniform(85, 100)), 60))
    return deciduous_canopy(seed, size=size, leaves=int(1100 * (size / 128) ** 1.2), base_hue=(int(rng.uniform(62, 82)), int(rng.uniform(115, 132)), int(rng.uniform(40, 50))))


def menu_backdrop(seed, path, size=(1280, 960), road_width=190, trees=26, shrubs=40, sand_trap=None, start_line=None):
    """A top-down view of a piece of race track for menu backgrounds.
    path holds the control points of the center line in pixels, sand_trap is an optional polygon of
    sand next to the road and start_line an optional position of a checkered line as a fraction of the path."""
    rng = np.random.default_rng(seed)
    s = SUPERSAMPLING
    w, h = size[0] * s, size[1] * s
    samples, normals = smooth_path(np.array(path) * s)
    samples, normals = dense_path(samples, normals, 2.0 * s)
    road_w = road_width * s

    rgb = grass_rgb(seed, w, h)

    sand_area = Image.new('L', (w, h), 0)
    if sand_trap:
        ImageDraw.Draw(sand_area).polygon([(x * s, y * s) for x, y in sand_trap], fill=255)
        sand_mask = np.asarray(sand_area.filter(ImageFilter.GaussianBlur(3 * s))).astype(np.float32)[..., None] / 255
        texture = sand_rgb(seed)
        tiles = np.tile(texture, (h // texture.shape[0] + 1, w // texture.shape[1] + 1, 1))[:h, :w]
        rgb = rgb * (1 - sand_mask) + tiles * sand_mask

    # Worn, dusty verge next to the road
    road = road_mask((w, h), samples, road_w)
    verge = np.asarray(road_mask((w, h), samples, road_w + 34 * s).filter(ImageFilter.GaussianBlur(12 * s))).astype(np.float32)[..., None] / 255
    rgb = rgb * (1 - 0.35 * verge) + np.array([150, 135, 100]) * 0.35 * verge
    contact_shadow = np.asarray(road_mask((w, h), samples, road_w + 8 * s).filter(ImageFilter.GaussianBlur(4 * s))).astype(np.float32)[..., None] / 255
    rgb *= 1 - 0.25 * contact_shadow

    # Asphalt with grain and a darker racing line
    size_max = max(w, h)
    asphalt = 1 + 0.05 * periodic_noise(rng, size_max, 1.0)[:h, :w] + 0.04 * periodic_noise(rng, size_max, 40)[:h, :w]
    asphalt_rgb = np.array([82, 82, 86])[None, None, :] * asphalt[..., None]
    racing_line = np.asarray(road_mask((w, h), samples, road_w * 0.35).filter(ImageFilter.GaussianBlur(20 * s))).astype(np.float32)[..., None] / 255
    asphalt_rgb *= 1 - 0.12 * racing_line
    road_alpha = np.asarray(road).astype(np.float32)[..., None] / 255
    rgb = rgb * (1 - road_alpha) + asphalt_rgb * road_alpha

    image = Image.fromarray(rgb.clip(0, 255).astype(np.uint8), 'RGB')
    draw = ImageDraw.Draw(image)

    # Tire marks
    for _ in range(5):
        start = int(rng.integers(0, len(samples) // 2))
        length = int(rng.integers(len(samples) // 8, len(samples) // 3))
        lateral = rng.uniform(-0.3, 0.3) * road_w
        drift = rng.normal(0, 0.08) * road_w
        part = slice(start, min(start + length, len(samples)))
        t = np.linspace(0, 1, len(samples[part]))[:, None]
        for track in (-1, 1):
            points = samples[part] + normals[part] * (lateral + drift * t + track * 9 * s)
            draw.line([tuple(p) for p in points], fill=(55, 55, 58), width=3 * s)

    # Edge lines as the difference of two road masks, and kerbs over them
    line_inset, line_width = 10 * s, 5 * s
    outer = road_mask((w, h), samples, road_w - 2 * line_inset + line_width)
    inner = road_mask((w, h), samples, road_w - 2 * line_inset - line_width)
    lines = Image.fromarray((np.asarray(outer).astype(np.int16) - np.asarray(inner)).clip(0, 255).astype(np.uint8), 'L')
    image.paste((225, 225, 220), (0, 0), lines)
    draw_kerbs(draw, samples, normals, road_w, 20 * s, 18 * s, min_length=150 * s)

    if start_line is not None:
        index = int(start_line * (len(samples) - 1))
        p, n = samples[index], normals[index]
        tangent = np.array([n[1], -n[0]])
        squares = 12
        square = road_w / squares
        for row in range(2):
            for column in range(squares):
                if (row + column) % 2:
                    continue
                a = p + n * (-road_w / 2 + column * square) + tangent * (row - 1) * square
                quad = [tuple(a), tuple(a + n * square), tuple(a + n * square + tangent * square), tuple(a + tangent * square)]
                draw.polygon(quad, fill=(235, 235, 230))

    # Plants and trees away from the road, smaller first so that trees cover them.
    # Trees need more clearance, because their crowns are wide.
    # Grow the sand area by a margin: a blurred mask is nonzero up to about two sigmas outside it
    sand_clearance = {kind: np.where(np.asarray(sand_area.filter(ImageFilter.GaussianBlur(margin * s / 2))) > 0, 255, 0)
                      for kind, margin in (('shrub', 15), ('tree', 45))} if sand_trap else None
    clearance = {
        'shrub': np.maximum(np.asarray(road_mask((w, h), samples, road_w + 90 * s)), sand_clearance['shrub'] if sand_trap else 0),
        'tree': np.maximum(np.asarray(road_mask((w, h), samples, road_w + 230 * s)), sand_clearance['tree'] if sand_trap else 0),
    }

    items = []
    for _ in range(shrubs):
        items.append(('shrub', int(rng.uniform(40, 70))))
    for _ in range(trees):
        items.append(('tree', int(rng.uniform(150, 240))))
    for kind, sprite_size in items:
        for _ in range(50):
            x, y = rng.uniform(-60, w / s + 60) * s, rng.uniform(-60, h / s + 60) * s
            if clearance[kind][int(min(max(y, 0), h - 1)), int(min(max(x, 0), w - 1))] == 0:
                break
        else:
            continue
        sprite = shrub(int(rng.integers(1000)), size=sprite_size) if kind == 'shrub' else tree_sprite(rng, sprite_size)
        sprite = sprite.resize((sprite_size * s, sprite_size * s), Image.LANCZOS).rotate(rng.uniform(0, 360))
        alpha = sprite.split()[3]
        # Soft shadow away from the light
        offset = int(sprite_size * s * (0.12 if kind == 'tree' else 0.06))
        shadow = Image.new('RGBA', sprite.size, (0, 0, 0, 0))
        shadow.putalpha(alpha.filter(ImageFilter.GaussianBlur(6 * s)).point(lambda a: int(a * 0.45)))
        corner = (int(x - sprite.size[0] / 2), int(y - sprite.size[1] / 2))
        image.paste(shadow, (corner[0] + offset, corner[1] + offset), shadow)
        image.paste(sprite, corner, sprite)

    image = image.resize(size, Image.LANCZOS)

    # Soft vignette so that the menu in the center stands out
    y, x = (np.mgrid[0:size[1], 0:size[0]] + 0.5)
    r = np.hypot((x / size[0] - 0.5) * 1.3, (y / size[1] - 0.5) * 1.3)
    vignette = 1 - 0.55 * np.clip(r - 0.25, 0, 1) ** 1.5
    pixels = np.asarray(image).astype(np.float32) * vignette[..., None]
    return Image.fromarray(pixels.clip(0, 255).astype(np.uint8), 'RGB')


# Grandstand layout in world units. Must match grandstand.cpp.
GRANDSTAND_SIZE = 128
GRANDSTAND_BACK_WALL = 8
GRANDSTAND_ROWS = 9
GRANDSTAND_SEATS = 16  # Per row, divisible by the 8 sections of grandstand.cpp

# Probabilities of being seated, waving one arm or standing with both arms up in each crowd frame
CROWD_POSES = [
    (0.93, 0.07, 0.0),  # Calm
    (0.93, 0.07, 0.0),  # Calm, different people moving
    (0.45, 0.35, 0.20),  # Excited
    (0.45, 0.35, 0.20),  # Excited, different people moving
    (0.08, 0.27, 0.65),  # Cheering
]

def muted(color, amount=0.3, toward=(150, 140, 120)):
    """Blends a color towards a warm gray, so that it fits the earthy palette of the game."""
    return tuple(int(c * (1 - amount) + t * amount) for c, t in zip(color, toward))


SHIRT_COLORS = [(185, 50, 45), (50, 80, 160), (220, 190, 60), (230, 228, 220), (40, 40, 45), (70, 130, 75),
                (210, 120, 50), (120, 70, 130), (100, 150, 190), (160, 160, 165), (110, 85, 65), (200, 150, 160)]
HAIR_COLORS = [(40, 28, 20), (70, 45, 25), (20, 18, 16), (190, 160, 90), (150, 150, 145), (140, 70, 30)]
SKIN_COLORS = [(235, 195, 160), (215, 165, 125), (170, 120, 85), (120, 80, 55)]
SHIRT_COLORS = [muted(color) for color in SHIRT_COLORS]
SEAT_BLUE = (72, 98, 120)
SEAT_RED = (150, 66, 50)
BOARD_COLORS = [muted(color, 0.35) for color in [(200, 40, 40), (240, 200, 40), (30, 100, 180), (245, 245, 240), (40, 140, 70), (230, 120, 30)]]


def lit(color, light):
    return tuple(int(np.clip(c * light, 0, 255)) for c in color)


def draw_spectator(draw, rng, x, y, unit, pose, person):
    """A spectator seen from above at (x, y), facing down in the image (towards the track).
    person holds the colors that stay the same in every frame."""
    shirt, hair, skin, cap, head_offset, build = person
    standing = pose == 2
    # Standing people are closer to the camera and lean forward a bit
    scale = build * (1.15 if standing else 1.0)
    y += 1.0 * unit if standing else 0
    shoulder_w, shoulder_h = 4.3 * unit * scale, 2.8 * unit * scale
    head_r = 2.1 * unit * scale

    # Shadow on the seats and steps away from the light
    shadow = 0.8 * unit * (1.6 if standing else 1.0)
    draw.ellipse((x - shoulder_w + shadow, y - shoulder_h + shadow, x + shoulder_w + shadow, y + shoulder_h + shadow), fill=(0, 0, 0, 70))

    def arm(direction_x, length):
        # A raised arm is seen foreshortened: a sleeve and a forearm from the shoulder up and out
        sx, sy = x + direction_x * shoulder_w * 0.8, y - shoulder_h * 0.2
        mx, my = sx + direction_x * length * 0.35, sy - length * 0.45
        ex, ey = sx + direction_x * length * 0.6, sy - length
        draw.line((sx, sy, mx, my), fill=lit(shirt, 0.95) + (255,), width=int(2.0 * unit))
        draw.line((mx, my, ex, ey), fill=skin + (255,), width=int(1.4 * unit))
        hand = 1.05 * unit
        draw.ellipse((ex - hand, ey - hand, ex + hand, ey + hand), fill=lit(skin, 1.1) + (255,))

    if pose == 1:
        arm(1 if rng.uniform() < 0.5 else -1, rng.uniform(4.5, 5.5) * unit * build)
    elif pose == 2:
        arm(-1, rng.uniform(5.0, 6.0) * unit * build)
        arm(1, rng.uniform(5.0, 6.0) * unit * build)

    # Shoulders: lit from the upper left
    draw.ellipse((x - shoulder_w, y - shoulder_h, x + shoulder_w, y + shoulder_h), fill=lit(shirt, 0.82) + (255,))
    draw.ellipse((x - shoulder_w * 0.92, y - shoulder_h * 0.95, x + shoulder_w * 0.75, y + shoulder_h * 0.7), fill=lit(shirt, 0.95) + (255,))

    # Head, turned a bit in some frames
    # Seen from above, hair covers most of the head and only the face peeks out towards the track
    hx, hy = x + head_offset[0] * unit, y + head_offset[1] * unit
    draw.ellipse((hx - head_r * 0.8, hy - head_r * 0.6, hx + head_r * 0.8, hy + head_r * 1.05), fill=skin + (255,))
    top = cap if cap else hair
    draw.ellipse((hx - head_r, hy - head_r, hx + head_r, hy + head_r * 0.75), fill=top + (255,))
    if cap:
        # The peak of the cap points towards the track
        draw.ellipse((hx - head_r * 0.7, hy + head_r * 0.3, hx + head_r * 0.7, hy + head_r * 1.3), fill=lit(cap, 0.85) + (255,))
    highlight = head_r * 0.45
    draw.ellipse((hx - head_r * 0.35 - highlight, hy - head_r * 0.4 - highlight, hx - head_r * 0.35 + highlight, hy - head_r * 0.4 + highlight), fill=lit(top, 1.12) + (255,))


def grandstand_crowd(frame, seed=20, pixels_per_unit=4):
    """A grandstand seen from above: a back wall and tiers of seats with spectators facing the track at
    the bottom. The frames show the same people in different poses."""
    rng = np.random.default_rng(seed)
    unit = pixels_per_unit * SUPERSAMPLING
    size = GRANDSTAND_SIZE * unit
    image = Image.new('RGBA', (size, size), (0, 0, 0, 255))
    draw = ImageDraw.Draw(image, 'RGBA')

    # Back wall with advertising boards
    wall = GRANDSTAND_BACK_WALL * unit
    draw.rectangle((0, 0, size, wall), fill=(124, 118, 106))
    board_width = size / 4
    for board in range(4):
        x0 = board * board_width + 0.5 * unit
        color = BOARD_COLORS[(board * 7 + 3) % len(BOARD_COLORS)]
        draw.rectangle((x0, 1.5 * unit, x0 + board_width - unit, wall - 1.5 * unit), fill=color)
        # A logo-like stripe on the board
        stripe = BOARD_COLORS[(board * 7 + 5) % len(BOARD_COLORS)]
        draw.rectangle((x0 + board_width * 0.2, wall / 2 - 0.8 * unit, x0 + board_width * 0.8, wall / 2 + 0.8 * unit), fill=stripe)
    draw.rectangle((0, 0, size, 0.8 * unit), fill=(165, 158, 144))
    row_depth = (size - wall) / GRANDSTAND_ROWS
    seat_width = size / GRANDSTAND_SEATS
    concrete = periodic_noise(np.random.default_rng(seed), size, 2 * SUPERSAMPLING)
    for row in range(GRANDSTAND_ROWS):
        top = wall + row * row_depth
        # Lower tiers are further from the light of the sky above the stand
        tone = 172 - row * 1.5
        draw.rectangle((0, top, size, top + row_depth), fill=(int(tone), int(tone * 0.96), int(tone * 0.88)))
        draw.rectangle((0, top + row_depth - 1.0 * unit, size, top + row_depth), fill=(108, 102, 92))
        # Plastic seats cover the tier: a backrest and a seat pan, lit from the upper left.
        # One red row forms a stripe through the stand.
        for seat in range(GRANDSTAND_SEATS):
            x0 = seat * seat_width + 0.3 * unit
            x1 = x0 + seat_width - 0.6 * unit
            color = SEAT_RED if row == 4 else SEAT_BLUE
            draw.rectangle((x0, top + 0.5 * unit, x1, top + 2.5 * unit), fill=lit(color, 0.75))
            draw.rectangle((x0 + 0.2 * unit, top + 2.5 * unit, x1 - 0.2 * unit, top + row_depth - 1.5 * unit), fill=color)
            draw.rectangle((x0 + 0.2 * unit, top + 2.5 * unit, x0 + 1.0 * unit, top + row_depth - 1.5 * unit), fill=lit(color, 1.2))

    # Weathered concrete
    pixels = np.asarray(image).astype(np.float32)
    pixels[..., :3] *= (1 + 0.04 * concrete)[..., None]
    image = Image.fromarray(pixels.clip(0, 255).astype(np.uint8), 'RGBA')
    draw = ImageDraw.Draw(image, 'RGBA')

    # Spectators. Their colors come from the same random sequence in every frame and
    # their poses from a sequence of the frame.
    pose_rng = np.random.default_rng(seed * 100 + frame)
    seated, waving, _ = CROWD_POSES[frame]
    # Empty seats come in clusters
    crowding = periodic_noise(np.random.default_rng(seed + 1), 64, 3)
    for row in range(GRANDSTAND_ROWS):
        for seat in range(GRANDSTAND_SEATS):
            occupied = crowding[row * 5 % 64, seat * 4 % 64] + rng.normal(0, 0.5) > -0.9
            person = (
                SHIRT_COLORS[rng.integers(len(SHIRT_COLORS))],
                HAIR_COLORS[rng.integers(len(HAIR_COLORS))],
                SKIN_COLORS[rng.integers(len(SKIN_COLORS))],
                SHIRT_COLORS[rng.integers(len(SHIRT_COLORS))] if rng.uniform() < 0.2 else None,
                (0.0, 0.0),
                rng.uniform(0.85, 1.1),
            )
            # People don't sit exactly in the middle of their seats
            offset = rng.uniform(-1.0, 1.0, 2) * unit
            roll = pose_rng.uniform()
            pose = 0 if roll < seated else (1 if roll < seated + waving else 2)
            # People turn their heads a bit
            head_offset = tuple(pose_rng.normal(0, 0.3, 2))
            person = person[:4] + (head_offset, person[5])
            if occupied:
                x = (seat + 0.5) * seat_width + offset[0]
                y = wall + row * row_depth + row_depth * 0.5 + offset[1]
                draw_spectator(draw, pose_rng, x, y, unit, pose, person)

    image = image.resize((size // SUPERSAMPLING, size // SUPERSAMPLING), Image.LANCZOS)
    return image.convert('RGB')


TEXTURES = {
    'tree': lambda: deciduous_canopy(seed=1),
    'tree2': lambda: deciduous_canopy(seed=2, base_hue=(80, 130, 40)),
    'tree3': lambda: deciduous_canopy(seed=3, base_hue=(62, 118, 50)),
    'pine': lambda: pine_canopy(seed=4),
    'pine2': lambda: pine_canopy(seed=5, branches=9, base_hue=(40, 88, 62)),
    'trunk': lambda: trunk(seed=6),
    'plant': lambda: shrub(seed=7),
    'bushArea': lambda: bush_area(seed=8),
    'sand': lambda: sand(seed=9),
    'sandAreaCurve': lambda: sand_area('sandAreaCurve.png', seed=9),
    'sandAreaBig': lambda: sand_area('sandAreaBig.png', seed=9),
    'cornerKerb': lambda: kerbed_mask('corner.png', lambda x, y: np.hypot(x - 512, y - 512) < 140),
    'corner45LeftKerb': lambda: kerbed_mask('corner45Left.png', lambda x, y: (x < 160) & (y > 200)),
    'corner45RightKerb': lambda: kerbed_mask('corner45Right.png', lambda x, y: (x > 352) & (y > 200)),
    'grandstandCrowd0': lambda: grandstand_crowd(0),
    'grandstandCrowd1': lambda: grandstand_crowd(1),
    'grandstandCrowd2': lambda: grandstand_crowd(2),
    'grandstandCrowd3': lambda: grandstand_crowd(3),
    'grandstandCrowd4': lambda: grandstand_crowd(4),
    'grandstandEditor': lambda: grandstand_crowd(0).resize((128, 128), Image.LANCZOS),
    # Menu backgrounds: a sweeping S-curve, a hairpin, a start/finish straight and a corner with a sand trap
    'mainMenuBack': lambda: menu_backdrop(10, [(-150, 760), (250, 650), (520, 420), (760, 300), (1060, 330), (1450, 120)]),
    'trackSelectionBack': lambda: menu_backdrop(11, [(-150, 250), (450, 260), (850, 330), (980, 520), (830, 720), (420, 760), (-150, 800)]),
    'settingsBack': lambda: menu_backdrop(12, [(-150, 560), (300, 520), (700, 470), (1100, 420), (1450, 380)], start_line=0.3),
    'creditsHelpBack': lambda: menu_backdrop(13, [(-150, 300), (400, 330), (760, 420), (930, 650), (980, 1120)],
                                             sand_trap=[(880, 120), (1300, 80), (1300, 700), (1150, 760), (1060, 520), (960, 380)]),
}


# Large opaque images are saved as JPEG to keep them small
JPEG_TEXTURES = {'mainMenuBack', 'trackSelectionBack', 'settingsBack', 'creditsHelpBack',
                 'grandstandCrowd0', 'grandstandCrowd1', 'grandstandCrowd2', 'grandstandCrowd3', 'grandstandCrowd4'}


def main(names):
    for name in names or TEXTURES:
        if name not in TEXTURES:
            sys.exit(f'Unknown texture: {name}')
        if name in JPEG_TEXTURES:
            path = IMAGE_PATH + name + '.jpg'
            print(f'Generating {path}..')
            TEXTURES[name]().save(path, quality=90, optimize=True)
        else:
            path = IMAGE_PATH + name + '.png'
            print(f'Generating {path}..')
            TEXTURES[name]().save(path, optimize=True)


if __name__ == '__main__':
    main(sys.argv[1:])
